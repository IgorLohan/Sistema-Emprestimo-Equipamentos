meta {
  name: Cadastrar equipamento
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/equipamentos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Notebook Lab 01",
    "tipo": "Notebook",
    "patrimonio": "PAT{{$timestamp}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) {
    bru.setEnvVar("equipamentoId", body.id);
  }
}

tests {
  test("201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("disponível", function() {
    expect(res.getBody().disponivel).to.equal(true);
  });
}
