meta {
  name: Repetir devolução
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/v1/emprestimos/{{emprestimoId}}/devolucao
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "condicao": "AVARIADO"
  }
}

tests {
  test("200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("permanece DEVOLVIDO", function() {
    expect(res.getBody().status).to.equal("DEVOLVIDO");
  });
}
